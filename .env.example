# Copy to backend/.env (non-Docker) or .env (Docker Compose) and adjust.
# Never commit real values. Leave optional integrations blank to keep them disabled.

# --- Backend (FastAPI) ---
NOEFFORTS_ENV=development
NOEFFORTS_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/noefforts
NOEFFORTS_REDIS_URL=redis://127.0.0.1:6379/0
# Where uploaded documents are stored (local filesystem backend).
NOEFFORTS_STORAGE_DIR=./var/storage
# Required: the server-held key for audit references (HMAC). At least 32 characters; never
# commit one. Generate your own, e.g. `openssl rand -hex 32`. The API refuses to start without it.
NOEFFORTS_AUDIT_REF_KEY=
# Set to true when served over HTTPS so the session cookie is Secure.
NOEFFORTS_COOKIE_SECURE=false
NOEFFORTS_CORS_ORIGINS=["http://localhost:3000"]
NOEFFORTS_SESSION_TTL_HOURS=168
NOEFFORTS_MAX_UPLOAD_BYTES=10485760
NOEFFORTS_MAX_IMPORT_ROWS=5000

# --- Execution (Phase C; local synthetic fixtures only) ---
# Browser isolation. "netns" (default outside Compose) needs Linux with unshare(1);
# "container" (what Compose uses) runs the browser in the browser-runner service behind the
# egress-proxy service. On macOS without Docker set "off" (never accepted in production).
NOEFFORTS_BROWSER_ISOLATION=netns
NOEFFORTS_FIXTURE_ORIGINS=[]
# Local fake authorized API (fixture only; ignored for real destinations). Leave empty.
NOEFFORTS_FAKE_API_TOKEN=
# Job discovery: off unless listed, e.g. ["freehire"]. The Freehire client accepts a local fixture
# base URL, or https://freehire.me only for an account listed in DISCOVERY_OWNER_EMAILS and only
# with that account's single-use run approval (D55, docs/discovery.md "Live read"). The optional
# key is server-side only.
NOEFFORTS_DISCOVERY_PROVIDERS=[]
NOEFFORTS_DISCOVERY_OWNER_EMAILS=[]
# Watched searches (D56): requests per UTC day across all watches (1,440 = one a minute).
NOEFFORTS_FREEHIRE_DAILY_REQUEST_BUDGET=1440
NOEFFORTS_FREEHIRE_BASE_URL=
NOEFFORTS_FREEHIRE_API_KEY=

# --- Optional, disabled when empty (Phase B+) ---
# AI drafting (L4, D74): off unless DRAFTING_PROVIDER=anthropic and the key is set; then only for
# accounts in DRAFTING_OWNER_EMAILS, after each agrees in the app, and within the daily budget in
# USD (0 sends nothing). The key is server-side only; never commit it.
NOEFFORTS_DRAFTING_PROVIDER=
NOEFFORTS_DRAFTING_OWNER_EMAILS=[]
NOEFFORTS_DRAFTING_DAILY_BUDGET_USD=0
NOEFFORTS_ANTHROPIC_API_KEY=

# --- Frontend (Next.js). Read at BUILD time: rebuild after changing. ---
NOEFFORTS_BACKEND_URL=http://127.0.0.1:8000

# --- Docker Compose only ---
POSTGRES_PASSWORD=postgres
# Shared only between the worker and the browser-runner / egress-proxy services. The values
# below are placeholders that only the CI smoke test runs with; `scripts/check_env.py` refuses
# them. Set your own, each different (`openssl rand -hex 32`). See docs/deployment.md.
BROWSER_RUNNER_TOKEN=local-placeholder-runner-token-change-me
EGRESS_CONTROL_TOKEN=local-placeholder-control-token-change-me
# Required, no placeholder: the audit reference key passed to the backend and worker
# (`openssl rand -hex 32`). The smoke and execution test scripts generate a throwaway one.
AUDIT_REF_KEY=
