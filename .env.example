# Copy to backend/.env (non-Docker) or .env (Docker Compose) and adjust.
# Never commit real values. Leave optional integrations blank to keep them disabled.

# --- Backend (FastAPI) ---
NOEFFORTS_ENV=development
NOEFFORTS_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/noefforts
NOEFFORTS_REDIS_URL=redis://127.0.0.1:6379/0
# Where uploaded documents are stored (local filesystem backend).
NOEFFORTS_STORAGE_DIR=./var/storage
# Set to true when served over HTTPS so the session cookie is Secure.
NOEFFORTS_COOKIE_SECURE=false
NOEFFORTS_CORS_ORIGINS=["http://localhost:3000"]
NOEFFORTS_SESSION_TTL_HOURS=168
NOEFFORTS_MAX_UPLOAD_BYTES=10485760
NOEFFORTS_MAX_IMPORT_ROWS=5000

# --- Execution (Phase C; local synthetic fixtures only) ---
# Browser isolation. "netns" (default outside Compose) needs Linux with unshare(1);
# "container" (what Compose uses) runs the browser in the browser-runner service behind the
# egress-proxy service. On macOS without Docker set "off" (never accepted in production).
NOEFFORTS_BROWSER_ISOLATION=netns
NOEFFORTS_FIXTURE_ORIGINS=[]
# Local fake authorized API (fixture only; ignored for real destinations). Leave empty.
NOEFFORTS_FAKE_API_TOKEN=

# --- Optional, disabled when empty (Phase B+) ---
NOEFFORTS_ANTHROPIC_API_KEY=

# --- Frontend (Next.js). Read at BUILD time: rebuild after changing. ---
NOEFFORTS_BACKEND_URL=http://127.0.0.1:8000

# --- Docker Compose only ---
POSTGRES_PASSWORD=postgres
# Shared only between the worker and the browser-runner / egress-proxy services. The values
# below are placeholders for local testing; generate your own (e.g. `openssl rand -hex 24`).
BROWSER_RUNNER_TOKEN=local-placeholder-runner-token-change-me
EGRESS_CONTROL_TOKEN=local-placeholder-control-token-change-me
