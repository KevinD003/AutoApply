{
  "manifest_version": 3,
  "name": "NoEfforts: save this job",
  "version": "0.1.0",
  "description": "Saves the job page you are on to your own NoEfforts. It sends the page's address and title only: it never reads, fills or submits the page.",
  "action": { "default_popup": "popup.html", "default_title": "Save this job to NoEfforts" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
